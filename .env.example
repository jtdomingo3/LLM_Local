# =============================================================
# LLM Local Microservice Configuration (Template)
# Copy this file to .env and adjust values as needed
# =============================================================

# Ollama connection
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Server config
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8100

# Default models
MODEL_DAILY=phi4-mini
MODEL_CODING=qwen2.5-coder:3b
MODEL_POWER_CODING=qwen2.5-coder:7b

# Generation defaults
DEFAULT_NUM_CTX=4096
DEFAULT_TEMPERATURE_CHAT=0.7
DEFAULT_TEMPERATURE_CODE=0.2
MAX_TOKENS=4096
MAX_TOKENS_CHAT=2048
MAX_TOKENS_CODE=2048

# Engine optimization (RTX 3050 4GB VRAM safeguards)
OLLAMA_KEEP_ALIVE=90s
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Response Caching (Zero GPU & RAM optimization)
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_MAX_SIZE=256
RESPONSE_CACHE_TTL_SECONDS=3600

# Smart Request Routing
SMART_ROUTING_ENABLED=true

# Logging
LOG_LEVEL=INFO

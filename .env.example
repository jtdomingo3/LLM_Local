# =============================================================
# LLM Local Microservice Configuration (Template)
# Copy this file to .env and adjust values as needed
# =============================================================

# Ollama connection
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Server config
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8100

# Default models
MODEL_DAILY=phi4-mini
MODEL_CODING=qwen2.5-coder:3b
MODEL_POWER_CODING=qwen2.5-coder:7b

# Generation defaults
DEFAULT_NUM_CTX=4096
DEFAULT_TEMPERATURE_CHAT=0.7
DEFAULT_TEMPERATURE_CODE=0.2
MAX_TOKENS=4096

# Logging
LOG_LEVEL=INFO
